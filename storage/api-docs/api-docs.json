    "components": {
        "schemas": {
            "DepartementSchema": {
                "title": "Département",
                "description": "Ressource département",
                "properties": {
                    "id": {
                        "type": "integer",
                        "example": 1
                    },
                    "slug": {
                        "type": "string",
                        "example": "informatique-abc123"
                    },
                    "name": {
                        "type": "string",
                        "example": "Informatique"
                    },
                    "description": {
                        "type": "string",
                        "example": "Département en charge de l'informatique."
                    },
                    "deletedept": {
                        "type": "boolean",
                        "example": false
                    },
                    "created_at": {
                        "type": "string",
                        "format": "date-time",
                        "example": "2025-08-18T12:34:56Z"
                    },
                    "updated_at": {
                        "type": "string",
                        "format": "date-time",
                        "example": "2025-08-18T12:34:56Z"
                    }
                },
